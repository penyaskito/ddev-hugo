#!/usr/bin/env bash

#ddev-generated
## Description: Run hugo inside the web container
## Usage: hugo [flags] [args]
## Example: "ddev hugo server" or "ddev hugo new content posts/hello.md"
## ExecRaw: true
## HostWorkingDir: true
## MutagenSync: true

set -eu

# Port Hugo's dev server listens on, routed by docker-compose.hugo.yaml.
HUGO_SERVER_PORT="${HUGO_SERVER_PORT:-1313}"

# True if the flag was already given, as either "--flag value" or "--flag=value".
has_flag() {
  local flag="$1"
  shift
  local arg
  for arg in "$@"; do
    case "$arg" in
      "$flag"|"$flag"=*) return 0 ;;
    esac
  done
  return 1
}

# `hugo server` defaults to binding 127.0.0.1, which is unreachable from the
# host, and it needs the routed URL to emit correct links and to point live
# reload at the right origin. Supply those, but only where the user has not
# passed the flag themselves.
if [ "${1:-}" = "server" ]; then
  shift
  defaults=()
  has_flag --bind "$@" || defaults+=(--bind 0.0.0.0)

  if ! has_flag --port "$@"; then
    defaults+=(--port "${HUGO_SERVER_PORT}")
    # Only 1313 is routed, so a URL built from HUGO_SERVER_PORT is only right
    # while Hugo is on that port. If the user picks their own --port, they
    # know their routing better than we do, so leave baseURL to them.
    if ! has_flag --baseURL "$@"; then
      defaults+=(--baseURL "${DDEV_PRIMARY_URL_WITHOUT_PORT}:${HUGO_SERVER_PORT}")
      # baseURL already carries the port; appending Hugo's own would double it.
      has_flag --appendPort "$@" || defaults+=(--appendPort=false)
    fi
  fi

  exec hugo server "${defaults[@]}" "$@"
fi

exec hugo "$@"
